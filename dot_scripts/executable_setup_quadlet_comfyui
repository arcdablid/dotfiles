#!/usr/bin/env bash
set ${SET_X:+-x} -eou pipefail

#------------------------------------------------------------------------------
# ANSI escape code variables.
# ------------------------------------------------------------------------------

# Usage: printf "I ${Red}love${Color_Off} Stack Overflow\n"
# If you are using the echo command, be sure to use the -e flag to allow backslash escapes.
# echo -e "I ${Red}love${Color_Off} Stack Overflow"

# Reset
Color_Off='\033[0m'       # Text Reset

# Regular Colors
Black='\033[0;30m'        # Black
Red='\033[0;31m'          # Red
Green='\033[0;32m'        # Green
Yellow='\033[0;33m'       # Yellow
Blue='\033[0;34m'         # Blue
Purple='\033[0;35m'       # Purple
Cyan='\033[0;36m'         # Cyan
White='\033[0;37m'        # White

# Bold
BBlack='\033[1;30m'       # Black
BRed='\033[1;31m'         # Red
BGreen='\033[1;32m'       # Green
BYellow='\033[1;33m'      # Yellow
BBlue='\033[1;34m'        # Blue
BPurple='\033[1;35m'      # Purple
BCyan='\033[1;36m'        # Cyan
BWhite='\033[1;37m'       # White

# Underline
UBlack='\033[4;30m'       # Black
URed='\033[4;31m'         # Red
UGreen='\033[4;32m'       # Green
UYellow='\033[4;33m'      # Yellow
UBlue='\033[4;34m'        # Blue
UPurple='\033[4;35m'      # Purple
UCyan='\033[4;36m'        # Cyan
UWhite='\033[4;37m'       # White

# Background
On_Black='\033[40m'       # Black
On_Red='\033[41m'         # Red
On_Green='\033[42m'       # Green
On_Yellow='\033[43m'      # Yellow
On_Blue='\033[44m'        # Blue
On_Purple='\033[45m'      # Purple
On_Cyan='\033[46m'        # Cyan
On_White='\033[47m'       # White

# High Intensity
IBlack='\033[0;90m'       # Black
IRed='\033[0;91m'         # Red
IGreen='\033[0;92m'       # Green
IYellow='\033[0;93m'      # Yellow
IBlue='\033[0;94m'        # Blue
IPurple='\033[0;95m'      # Purple
ICyan='\033[0;96m'        # Cyan
IWhite='\033[0;97m'       # White

# Bold High Intensity
BIBlack='\033[1;90m'      # Black
BIRed='\033[1;91m'        # Red
BIGreen='\033[1;92m'      # Green
BIYellow='\033[1;93m'     # Yellow
BIBlue='\033[1;94m'       # Blue
BIPurple='\033[1;95m'     # Purple
BICyan='\033[1;96m'       # Cyan
BIWhite='\033[1;97m'      # White

# High Intensity backgrounds
On_IBlack='\033[0;100m'   # Black
On_IRed='\033[0;101m'     # Red
On_IGreen='\033[0;102m'   # Green
On_IYellow='\033[0;103m'  # Yellow
On_IBlue='\033[0;104m'    # Blue
On_IPurple='\033[0;105m'  # Purple
On_ICyan='\033[0;106m'    # Cyan
On_IWhite='\033[0;107m'   # White

# ------------------------------------------------------------------------------

executor="${0##*/}"
executor_path="${BASH_SOURCE}"
while [ -L "${executor_path}" ]; do
    executor_dir="$(cd -P "$(dirname "${executor_path}")" >/dev/null 2>&1 && pwd)"
    executor_path="$(readlink "${executor_path}")"
    [[ ${executor_path} != /* ]] && executor_path="${executor_dir}/${executor_path}"
done
executor_path="$(readlink -f "${executor_path}")"
executor_dir="$(cd -P "$(dirname -- "${executor_path}")" >/dev/null 2>&1 && pwd)"

declare -a required_cmds=( "systemctl" "podman" "openssl" "expand_path" )

fail=false
for rc in "${required_cmds[@]}"; do
    if ! command -v "${rc}" &> /dev/null ; then
        printf "[${executor}] [ERROR] Command '${rc}' unavailable!?"
        fail=true
    fi
done
[[ "${fail}" == true ]] && exit 1

# ------------------------------------------------------------------------------

REMOVE="false"

usage() {
    echo "Usage: ${executor} [-h] [-v]" >&2
}

while getopts ":rh" opt; do
    case $opt in
        r) REMOVE="true" ;;
        h) usage; exit 0 ;;
        \?) usage; exit 1 ;;
        :) usage; exit 1 ;;
    esac
done

shift $((OPTIND - 1))

app_name="comfyui"

if [[ "${REMOVE}" == "true" ]]; then

    if [[ "$( podman version --format '{{.Client.Version}}' | cut -d '.' -f 1 )" -gt "5" ]]; then
        # --force, -f
        # Remove running Quadlets (in case of uninstantiated template quadlets, stop its instances).
        # --ignore, -i
        # Do not error for Quadlets that do not exist.
        # --recursive
        # Required when removing applications (default false).
        podman quadlet rm --force --ignore --recursive -- "${app_name}"
    else

        [[ "$( systemctl --user is-active "quadlet-${app_name}" )" == "active" ]] && systemctl --user stop "quadlet-${app_name}"

        printf "[${executor}] ${BPurple}INFO${Color_Off} - Remove quadlet container files...\n"
        rm -fv "$HOME/.config/containers/systemd/quadlet-${app_name}".*

        printf "[${executor}] ${BPurple}INFO${Color_Off} - Reload systemd...\n"
        systemctl --user daemon-reload

        printf "[${executor}] ${BPurple}INFO${Color_Off} - Remove quadlet init files...\n"
        rm -rfv "$HOME/.config/quadlets/init/${app_name}"

    fi

else

    read -e -p "Enter config location:" -i "$HOME/.config/quadlets/data/${app_name}" data_location

    echo
    printf "[${executor}] ${BPurple}INFO${Color_Off} - Ensuring required directories are present...\n"
    mkdir -pv "$HOME/.config/containers/systemd"
    mkdir -pv "$HOME/.config/quadlets/init/${app_name}"
    mkdir -pv "$( expand_path "${data_location}" )"{/models,/output,/settings,/tls,/custom_nodes}
    # mkdir -pv "${data_location}"{/models{/diffusion_models,/unet,/vae,/text_encoders,/clip,/checkpoints,/lora},/output,/settings,/workflows,/tls,/custom_nodes}

    if [[ ! -f "${data_location}/tls/key.pem" || ! -f "${data_location}/tls/cert.pem" ]]; then
        openssl req -x509 -newkey rsa:4096 \
            -keyout "${data_location}/tls/key.pem" \
            -out "${data_location}/tls/cert.pem" \
            -sha256 -days 3650 -nodes \
            -subj "/C=CU/ST=${app_name}/L=${app_name}/O=${app_name}/OU=${app_name}/CN=${app_name}"
    fi

    echo
    printf "[${executor}] ${BPurple}INFO${Color_Off} - Creating quadlet...\n"

    ENTRYPOINT='
#!/bin/bash
set -e

COMFYUI_DIR="/workspace/ComfyUI"
NODES_DIR="$COMFYUI_DIR/custom_nodes"

# ── ComfyUI: clone or update ────────────────────────────────────────────────
if [ -d "$COMFYUI_DIR/.git" ]; then
    echo "► Updating ComfyUI..."
    cd "$COMFYUI_DIR" && git pull --ff-only || echo "  (already up to date)"
else
    echo "► Cloning ComfyUI..."
    git clone https://github.com/comfyanonymous/ComfyUI.git /tmp/ComfyUI
    cp -r /tmp/ComfyUI/. "$COMFYUI_DIR/"
    rm -rf /tmp/ComfyUI
fi

# ── Install / update ComfyUI requirements ───────────────────────────────────
echo "► Installing ComfyUI requirements..."
cd "$COMFYUI_DIR"
pip install -r requirements.txt --quiet

# ── Custom Node Manager (ComfyUI-Manager) ───────────────────────────────────
MANAGER_DIR="$NODES_DIR/ComfyUI-Manager"
if [ -d "$MANAGER_DIR/.git" ]; then
    echo "► Updating ComfyUI-Manager..."
    cd "$MANAGER_DIR" && git pull --ff-only || true
else
    echo "► Installing ComfyUI-Manager..."
    git clone https://github.com/ltdrdata/ComfyUI-Manager.git "$MANAGER_DIR"
fi

if [ -f "$MANAGER_DIR/requirements.txt" ]; then
    pip install -r "$MANAGER_DIR/requirements.txt" --quiet
fi

# ── Extra custom nodes (add more here as needed) ────────────────────────────
install_node() {
    local name="$1"
    local repo="$2"
    local dir="$NODES_DIR/$name"

    if [ -d "$dir/.git" ]; then
        echo "► Updating $name..."
        cd "$dir" && git pull --ff-only || true
    else
        echo "► Installing $name..."
        git clone "$repo" "$dir"
    fi

    if [ -f "$dir/requirements.txt" ]; then
        pip install -r "$dir/requirements.txt" --quiet
    fi
}

# Uncomment to add nodes:
install_node "ComfyUI_essentials" "https://github.com/cubiq/ComfyUI_essentials.git"
install_node "rgthree-comfy" "https://github.com/rgthree/rgthree-comfy.git"
install_node "ComfyUI-GGUF" "https://github.com/city96/ComfyUI-GGUF.git"
install_node "ComfyUI-AMDGPUMonitor" "https://github.com/kyuz0/ComfyUI-AMDGPUMonitor.git"
install_node "ComfyUI-Impact-Pack" "https://github.com/ltdrdata/ComfyUI-Impact-Pack.git"
install_node "ComfyUI-Crystools" "https://github.com/crystian/ComfyUI-Crystools.git"
install_node "ComfyUI-KJNodes" "https://github.com/kijai/ComfyUI-KJNodes.git"
install_node "ComfyUI_UltimateSDUpscale" "https://github.com/ssitu/ComfyUI_UltimateSDUpscale.git"
install_node "ComfyUI-Custom-Scripts" "https://github.com/pythongosssss/ComfyUI-Custom-Scripts.git"
install_node "Image Size Tool" "https://github.com/TheLustriVA/ComfyUI-Image-Size-Tools.git"
install_node "CG Use Everywhere" "https://github.com/chrisgoringe/cg-use-everywhere.git"
install_node "ControlAltAI_Nodes" "https://github.com/gseth/ControlAltAI-Nodes.git"

# install_node "ComfyUI-VideoHelperSuite" "https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git"
# install_node "ComfyUI_IPAdapter_plus" "https://github.com/cubiq/ComfyUI_IPAdapter_plus.git"

# WorkFlow for Flux.dev by Danrisi (txt2img, img2img, upscale and some QoL stuff)
# https://civitai.com/models/1662914/workflow-for-fluxdev-by-danrisi-txt2img-img2img-upscale-and-some-qol-stuff
install_node "ComfyUI-GGUF-FantasyTalking" "https://github.com/kael558/ComfyUI-GGUF-FantasyTalking.git"

# ── Launch ───────────────────────────────────────────────────────────────────

# Print ready message once ComfyUI responds
(
    while ! curl -s http://0.0.0.0:8188 > /dev/null 2>&1; do
        sleep 2
    done
    echo ""
    echo "╔══════════════════════════════════════════╗"
    echo "║   ComfyUI is ready:                      ║"
    echo "║   http://127.0.0.1:8188                  ║"
    echo "╚══════════════════════════════════════════╝"
    echo ""
) &

cd "$COMFYUI_DIR"
exec python main.py --tls-keyfile "$COMFYUI_DIR"/tls/key.pem --tls-certfile "$COMFYUI_DIR"/tls/cert.pem --listen 0.0.0.0 ${CLI_ARGS}
'
    echo "${ENTRYPOINT}" | tee "$HOME/.config/quadlets/init/${app_name}/quadlet-${app_name}.entrypoint" > /dev/null

    CONTAINERFILE="
FROM docker.io/rocm/pytorch:latest

# System dependencies
RUN apt-get update && apt-get install -y \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Copy and enable the startup script
COPY quadlet-${app_name}.entrypoint /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Expose the port that ComfyUI will use (change if needed)
EXPOSE 8188

ENTRYPOINT ["/entrypoint.sh"]
"
    echo "${CONTAINERFILE}" | tee "$HOME/.config/quadlets/init/${app_name}/quadlet-${app_name}.Containerfile" > /dev/null

    BUILD="
[Build]
ImageTag=localhost/quadlet-${app_name}:latest
File=quadlet-${app_name}.Containerfile
SetWorkingDirectory=unit
"
    echo "${BUILD}" | tee "$HOME/.config/quadlets/init/${app_name}/quadlet-${app_name}.build" > /dev/null

    CONTAINER="
[Unit]
Description=${app_name} quadlet
Wants=network-online.target
After=network-online.target
# Limit to 5 restart attempts within a 60 second window
StartLimitIntervalSec=60
StartLimitBurst=5

[Container]
ContainerName=quadlet-${app_name}
Image=quadlet-${app_name}.build
# AutoUpdate=registry

# persist your tls certs:
Volume=${data_location}/tls:/workspace/ComfyUI/tls:Z
# persist your models:
Volume=${data_location}/models:/workspace/ComfyUI/models:Z
# persist your custom nodes:
Volume=${data_location}/custom_nodes:/workspace/ComfyUI/custom_nodes:Z
# persist your output images:
Volume=${data_location}/output:/workspace/ComfyUI/output:Z
# persist all your settings & extra nodes:
Volume=${data_location}/settings:/workspace/ComfyUI/user:Z

# Networking: Pasta is used by default in Podman 5+
# If you need to access host services (like Ollama on the host):
AddHost=host.containers.internal:host-gateway

HostName=quadlet-${app_name}
PublishPort=8188:8188

SeccompProfile=unconfined
# AddCapability=SYS_PTRACE
AddDevice=/dev/kfd
AddDevice=/dev/dri
GroupAdd=video
GroupAdd=render

Environment=CLI_ARGS=       # e.g. --lowvram --disable-pinned-memory

# Maintenance & Logging
# Log to JSON files
LogDriver=k8s-file
PodmanArgs=--log-opt=max-size=10m --log-opt=max-file=3

[Service]
Restart=always
RestartSec=5
# Give image pulls/builds enough time during startup
TimeoutStartSec=900
# Give the container time to shut down gracefully
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target default.target
"
    echo "${CONTAINER}" | tee "$HOME/.config/quadlets/init/${app_name}/quadlet-${app_name}.container" > /dev/null

    printf "[${executor}] ${BPurple}INFO${Color_Off} - Installing quadlet...\n"
    if [[ "$( podman version --format '{{.Client.Version}}' | cut -d '.' -f 1 )" -gt "5" ]]; then
        podman quadlet install --replace --application "${app_name}" -- "$HOME/.config/quadlets/init/${app_name}/"
    else
        cp "$HOME/.config/quadlets/init/${app_name}/"* "$HOME/.config/containers/systemd/"

        printf "[${executor}] ${BPurple}INFO${Color_Off} - Reload systemd...\n"
        systemctl --user daemon-reload

        printf "[${executor}] ${BPurple}INFO${Color_Off} - Start/enable quadlet...\n"
        systemctl --user restart "quadlet-${app_name}"
    fi

    # Start user services even when not logged in
    loginctl enable-linger $USER

    printf "[${executor}] ${BPurple}INFO${Color_Off} - Enable automatic podman updates...\n"
    # 'AutoUpdate=registry' in the systemd definition allows the container to be auto-updated,
    # manually by calling 'podman auto-update'
    # or automatically by enabling the relative systemd service:
    systemctl enable --user --now podman-auto-update.timer

fi
